{
  "name": "@bizuri/local-engine",
  "version": "0.1.0-dev",
  "description": "Bizuri offline local engine. Runs in the Electron main process; no Angular coupling.",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "peerDependencies": {
    "better-sqlite3-multiple-ciphers": ">=12.0.0",
    "electron": ">=30.0.0"
  },
  "dependencies": {
    "@bizuri/local-store": "0.1.0-dev"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./preload": {
      "types": "./dist/gateway/preload.d.ts",
      "default": "./dist/gateway/preload.js"
    }
  }
}