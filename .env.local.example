# Bizuri live smoke test configuration.
#
# Copy to `.env.local` and fill in. `.env.local` is gitignored and must stay that
# way: it holds a real password for a real environment.
#
#   cp .env.local.example .env.local
#   $EDITOR .env.local
#   npm run smoke:dry      # hydrate + sell locally, push NOTHING
#   npm run smoke:live     # full loop, creates a REAL sale
#
# Values already present in the environment take precedence over this file, so a
# one-off override still works:
#
#   BIZURI_API=https://bizuri-api.staging.eccellenza.tech npm run smoke:dry

# --- required ---------------------------------------------------------------

BIZURI_EMAIL=
BIZURI_PASSWORD=

# Tenant subdomain slug, the same one the web app uses. Not the full hostname:
# if you sign in at https://acme.bizuri.testing.eccellenza.tech, this is `acme`.
BIZURI_SLUG=

# --- optional ---------------------------------------------------------------

# Defaults to the testing host.
#
# NOTE the hostname. The live host is `api.bizuri.testing.eccellenza.tech`.
# The frontend environment files and the OpenAPI server enum both still name
# `bizuri-api.testing.eccellenza.tech`, which now returns a Cloudflare 525.
# The host moved and those references are stale.
#   testing  https://api.bizuri.testing.eccellenza.tech   (default, verified 200)
#   staging  https://api.bizuri.staging.eccellenza.tech   (unverified)
#   prod     do not point smoke:live at production
# BIZURI_API=https://api.bizuri.testing.eccellenza.tech

# Branch uuid. Only needed if the login response returns no branchId, which
# happens for users not pinned to a single branch.
# BIZURI_BRANCH=

# Hydrate and sell locally, but never push. Same as `npm run smoke:dry`.
# BIZURI_DRY_RUN=1

# Keep the local SQLite file instead of using a temp file that is deleted on
# exit. Useful for inspecting what hydration actually wrote:
#   sqlite3 ./smoke.sqlite 'select item_name, selling_price, available_qty from sales_catalog limit 20;'
# BIZURI_DB=./smoke.sqlite
